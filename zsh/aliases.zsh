# ls
alias ls='ls --color=auto'
alias ll='ls -lh'
alias la='ls -lAh'
alias lt='ls -lhtr'

# Safety
alias rm='rm -i'
alias cp='cp -i'
alias mv='mv -i'

# Navigation
alias ..='cd ..'

# Grep
alias grep='grep --color=auto'

# lazygit
alias lg='lazygit'

# zsh config
alias zshconfig='$EDITOR ${ZDOTDIR}/.zshrc'
alias zshreload='source ${ZDOTDIR}/.zshrc'
